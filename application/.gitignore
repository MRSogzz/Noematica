# application/ 專屬的 .gitignore（Node/TS 專案慣例：跟著 package.json 放在同一層）
# repo 根目錄的 .gitignore 管跨層的東西（runtime/cache、epistemic/.index/runtime）；
# 這裡管的是這個 Node 專案自己的執行期產物。

# ── 依賴 ────────────────────────────────────────────────────
node_modules/

# ── 環境變數（含 API Key、HUD_TOKEN）────────────────────────
.env
.env.local
.env.*.local

# ── 系統快取 ─────────────────────────────────────────────────
.system/vector-cache.json
.system/ci/

# ── 編譯產物 ─────────────────────────────────────────────────
dist/
build/
*.js.map

# ── OS / 編輯器 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ── Log ──────────────────────────────────────────────────────
*.log
npm-debug.log*
