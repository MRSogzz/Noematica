# LLM WIKI — Environment Variables
# Copy to .env and fill in values
# 注意：所有指令都要在 application/ 這個目錄下執行（npm run dev 等），
# 因為 package.json 就放在這裡；下面的路徑預設值都是相對於 application/。

# Git API (choose one)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GIT_REMOTE_URL=https://github.com/your-org/llm-wiki.git

# OpenAI (for vector embeddings in F3, or AI provider = openai)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Anthropic（wiki/ 知識整理功能的預設 AI provider）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Hermes Agent（AI provider = hermes 時使用，多輪 tool-calling 整理知識）
HERMES_API_KEY=
HERMES_BASE_URL=http://127.0.0.1:8642

# Epistemic Adapter（Python FastAPI 服務，見 integration/epistemic_adapter/http_server.py）
EPISTEMIC_API=http://127.0.0.1:8765
EPISTEMIC_PORT=8765

# Server
# 注意：PORT 預設 3001，跟 README 的 `npx serve frontend/`（預設 3000）不要用同一個 port，
# 否則後端 API 跟前端靜態伺服器會搶同一個 port。
PORT=3001
NODE_ENV=development

# Paths（相對於 application/；docs/ 與 wiki/ 已搬到 repo 頂層 knowledge/ 底下，
# 所以它們的預設值用 ../knowledge/... 往上一層找，不要改成 ./docs、./wiki）
MODULES_DIR=./modules
DOCS_DIR=../knowledge/docs
WIKI_DIR=../knowledge/wiki
SYSTEM_DIR=./.system
NOTES_DIR=./.system/user/notes
MILESTONES_DIR=./milestones
